---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  return topics.map(topic => ({
    params: { slug: topic.slug || topic.id.replace(/\.md$/, '') },
    props: { topic },
  }));
}

const { topic } = Astro.props;

if (!topic) {
  throw new Error(`Topic not found: ${Astro.params.slug}`);
}

const { Content } = await render(topic);
---

<BaseLayout title={topic.data.title}>

  <article class="topic-post">

    <div class="topic-header">
      <h1>{topic.data.title}</h1>
      <div class="topic-meta">
        <span class="faculty">{topic.data.faculty}</span>
        <span class="department">{topic.data.department}</span>
        {topic.data.level && <span class="level">{topic.data.level}</span>}
      </div>
    </div>

    <div class="topic-abstract">
      <h3>Abstract</h3>
      <p>{topic.data.abstract}</p>
    </div>

    <div class="topic-content">
      <Content />
    </div>

    <div class="topic-footer">
      <a href="/topics" class="back-link">← Back to Topics</a>
      <a href="https://wa.me/2347084857977?text=Hello%20Premium%20Projects%2C%20I%20need%20help%20with%20a%20research%20topic." class="whatsapp-btn">Get This Material →</a>
    </div>

  </article>

  <style>
    .topic-post {
      max-width: 800px;
      margin: 0 auto;
    }

    .topic-header {
      margin-bottom: 2rem;
    }

    .topic-header h1 {
      font-size: 2rem;
      margin-bottom: 1rem;
    }

    .topic-meta {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .faculty, .department, .level {
      background: #667eea;
      color: white;
      padding: 5px 15px;
      border-radius: 20px;
      font-size: 0.9rem;
    }

    .topic-abstract {
      background: #f5f5f5;
      padding: 1.5rem;
      border-radius: 8px;
      margin-bottom: 2rem;
    }

    .topic-abstract h3 {
      margin-top: 0;
      color: #667eea;
    }

    .topic-content {
      line-height: 1.8;
      margin-bottom: 3rem;
    }

    .topic-footer {
      display: flex;
      gap: 1rem;
      padding-top: 2rem;
      border-top: 1px solid #ddd;
    }

    .back-link {
      color: #667eea;
      text-decoration: none;
    }

    .whatsapp-btn {
      background: #25D366;
      color: white;
      padding: 10px 20px;
      border-radius: 5px;
      text-decoration: none;
      margin-left: auto;
    }
  </style>

</BaseLayout>
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  return topics.map(topic => ({
    params: { slug: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const { Content } = await topic.render();
---

<BaseLayout title={topic.data.title}>

  <article class="topic-page">

    <div class="topic-header">
      <span class="badge">{topic.data.faculty}</span>
      <span class="badge">{topic.data.department}</span>
      {topic.data.level && <span class="badge">{topic.data.level}</span>}
      <h1>{topic.data.title}</h1>
    </div>

    {topic.data.abstract && (
      <div class="abstract-box">
        <h2>Abstract</h2>
        <p>{topic.data.abstract}</p>
      </div>
    )}

    <div class="topic-content">
      <Content />
    </div>

    <div class="cta-box">
      <h3>Need Help With This Project?</h3>
      <p>Our team can help you write, structure, and complete this research project.</p>
      <a href="https://wa.me/2347084857977?text=Hello%20Premium%20Projects%2C%20I%20need%20help%20with%20a%20research%20project." class="whatsapp-btn">Chat on WhatsApp</a>
      <a href="/contact" class="contact-btn">Request Assistance</a>
    </div>

  </article>

  <style>
    .topic-header {
      margin-bottom: 2rem;
    }

    .topic-header h1 {
      font-size: 2rem;
      margin-top: 1rem;
    }

    .abstract-box {
      background: #f0f4ff;
      border-left: 4px solid #667eea;
      padding: 1.5rem;
      margin: 2rem 0;
      border-radius: 5px;
    }

    .abstract-box h2 {
      color: #667eea;
      margin-top: 0;
    }

    .topic-content {
      margin: 2rem 0;
      line-height: 1.8;
    }

    .topic-content h2 {
      font-size: 1.5rem;
      margin-top: 2rem;
      margin-bottom: 1rem;
      color: #2c3e50;
    }

    .topic-content h3 {
      font-size: 1.2rem;
      margin-top: 1.5rem;
      margin-bottom: 0.8rem;
    }

    .topic-content ol, .topic-content ul {
      margin-left: 2rem;
      margin-bottom: 1rem;
    }

    .topic-content li {
      margin-bottom: 0.5rem;
    }

    .cta-box {
      background: #fff3cd;
      border: 2px solid #ffc107;
      padding: 2rem;
      margin-top: 3rem;
      border-radius: 8px;
      text-align: center;
    }

    .cta-box h3 {
      color: #856404;
      margin-top: 0;
    }

    .contact-btn {
      display: inline-block;
      background: #667eea;
      color: white;
      padding: 10px 20px;
      border-radius: 5px;
      text-decoration: none;
      margin: 0 10px;
      font-weight: bold;
      transition: background 0.3s;
    }

    .contact-btn:hover {
      background: #5568d3;
    }
  </style>

</BaseLayout>
---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allTopics = await getCollection('topics', ({ data }) => !data.draft);

const sortedTopics = allTopics.sort((a, b) => {
  if (!a.data.date && !b.data.date) return 0;
  if (!a.data.date) return 1;
  if (!b.data.date) return -1;
  return new Date(b.data.date) - new Date(a.data.date);
});
---

<BaseLayout title="Research Topics">

  <section class="topics-hero">
    <h1>Research Topics</h1>
    <p>Explore our collection of research topics across various faculties and departments</p>
  </section>

  {sortedTopics.length > 0 ? (
    <div class="topics-grid">
      {sortedTopics.map(topic => {
        const slug = topic.slug || topic.id.replace(/\.md$/, '');
        return (
          <div class="topic-card">
            <h2><a href={`/topics/${slug}`}>{topic.data.title}</a></h2>
            <div class="topic-meta">
              <span class="faculty">{topic.data.faculty}</span>
              <span class="department">{topic.data.department}</span>
              {topic.data.level && <span class="level">{topic.data.level}</span>}
            </div>
            <p class="abstract">{topic.data.abstract?.substring(0, 200)}...</p>
            <a href={`/topics/${slug}`} class="read-more">View Topic →</a>
          </div>
        );
      })}
    </div>
  ) : (
    <p>No research topics available yet. Check back soon!</p>
  )}

  <style>
    .topics-hero {
      background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
      color: white;
      padding: 3rem 2rem;
      border-radius: 10px;
      margin-bottom: 3rem;
      text-align: center;
    }

    .topics-hero h1 {
      color: white;
    }

    .topics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
      gap: 2rem;
    }

    .topic-card {
      background: white;
      padding: 1.5rem;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      transition: transform 0.3s;
    }

    .topic-card:hover {
      transform: translateY(-3px);
    }

    .topic-card h2 {
      margin-top: 0;
      margin-bottom: 1rem;
      font-size: 1.3rem;
    }

    .topic-card h2 a {
      color: #1e3c72;
      text-decoration: none;
    }

    .topic-card h2 a:hover {
      color: #667eea;
    }

    .topic-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }

    .faculty, .department, .level {
      background: #f0f0f0;
      padding: 3px 10px;
      border-radius: 15px;
      font-size: 0.8rem;
      color: #666;
    }

    .abstract {
      color: #666;
      line-height: 1.6;
      margin: 1rem 0;
    }

    .read-more {
      color: #25D366;
      text-decoration: none;
      font-weight: bold;
    }
  </style>

</BaseLayout>
---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Thank You">
  <section style="text-align:center;padding:4rem 1rem;">
    <h1>Thanks — we received your message</h1>
    <p style="max-width:760px;margin:1rem auto;color:#475569;">Our team has received your message and will contact you via your provided email or WhatsApp within 1 hour. If this is urgent, please message us on WhatsApp now.</p>
    <div style="display:flex;gap:1rem;justify-content:center;margin-top:1.75rem;flex-wrap:wrap;">
      <a class="btn btn-primary" href="/">Return Home</a>
      <a class="btn btn-secondary" href="https://wa.me/2347084857977?text=Hello%20Premium%20Projects%2C%20I%20sent%20a%20form%20and%20would%20like%20an%20update." target="_blank">Message on WhatsApp</a>
    </div>
  </section>
</BaseLayout>

---
const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | PREMIUM PROJECTS</title>
  <meta name="description" content={description || "Professional research project writing and support for Nigerian students"} />
  <style>
    :root{
      --brand-navy: #0b2545;
      --brand-gold: #d4af37;
      --muted: #6b7280;
      scroll-behavior: smooth;
    }
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      line-height: 1.75;
      color: #1f283e;
      background: radial-gradient(circle at top, rgba(28, 76, 146, 0.07), transparent 30%), #f4f7fb;
      font-size: 17px;
    }

    header {
      background: rgba(7, 32, 70, 0.98);
      color: white;
      padding: 1rem 0;
      box-shadow: 0 12px 36px rgba(0, 0, 0, 0.16);
      position: sticky;
      top: 0;
      z-index: 11;
    }

    nav {
      max-width: 1240px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      padding: 0 20px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 0.9rem;
      text-decoration: none;
      color: white;
    }

    .brand-logo {
      height: 46px;
      width: auto;
      display: block;
    }

    .brand-name {
      font-size: 1.2rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #f8d261;
    }

    .nav-links { display: flex; align-items: center; }

    nav ul {
      display: flex;
      list-style: none;
      gap: 1.6rem;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-end;
    }

    a {
      cursor: pointer;
    }

    nav a {
      color: white;
      text-decoration: none;
      transition: color 0.25s ease, transform 0.25s ease;
      font-weight: 600;
      font-size: 0.95rem;
    }

    nav a:hover {
      color: #f8d261;
      transform: translateY(-1px);
    }

    .nav-toggle {
      display: none;
      font-size: 1.45rem;
      color: white;
      cursor: pointer;
      border: none;
      background: transparent;
    }

    main {
      max-width: 1240px;
      margin: 0 auto;
      padding: 2rem 20px;
      min-height: calc(100vh - 240px);
    }

    h1, h2, h3, h4 {
      color: #11213f;
      margin: 0;
      font-weight: 700;
      line-height: 1.1;
    }

    h1 { font-size: clamp(2.4rem, 4vw, 3.6rem); }
    h2 { font-size: clamp(1.9rem, 3vw, 2.6rem); }
    h3 { font-size: 1.2rem; }

    p {
      color: #3f4f6d;
      margin: 0;
      font-size: 1.05rem;
    }

    section { padding: 3rem 0; }

    .section-intro {
      max-width: 760px;
      margin-bottom: 1.75rem;
      color: #4b5871;
      font-size: 1.05rem;
    }

    .btn,
    .whatsapp-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      padding: 14px 26px;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 700;
      letter-spacing: 0.01em;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
.hire-btn {
  background: linear-gradient(90deg, #25D366, #128C7E);
  color: white !important;
  padding: 8px 20px;
  border-radius: 50px;
  font-weight: bold;
  transition: all 0.3s ease;
}

.hire-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 5px 15px rgba(37, 211, 102, 0.3);
  color: white !important;
}

@media (max-width: 900px) {
  .hire-btn {
    display: inline-block;
    text-align: center;
    margin-top: 5px;
  }
}
    .btn-primary,
    .whatsapp-btn {
      background: linear-gradient(90deg, #39c469 0%, #1ca154 100%);
      color: white;
      box-shadow: 0 12px 30px rgba(26, 158, 90, 0.18);
    }

    .btn-primary:hover,
    .whatsapp-btn:hover {
      transform: translateY(-2px);
    }

    .btn-secondary {
      background: white;
      color: #0b244f;
      border: 1px solid rgba(11, 36, 79, 0.14);
      box-shadow: 0 10px 25px rgba(11, 36, 79, 0.08);
    }

    .btn-secondary:hover { background: #f8f9fb; }

    .whatsapp-float {
      position: fixed;
      bottom: 28px;
      right: 28px;
      background: linear-gradient(90deg, #25d366, #12b354);
      color: white;
      padding: 14px 20px;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 700;
      z-index: 9999;
      box-shadow: 0 20px 44px rgba(10, 98, 53, 0.18);
      transition: transform 0.2s ease;
    }

    .whatsapp-float:hover { transform: translateY(-2px); }

    footer {
      background: #08172f;
      color: #cbd5ea;
      padding: 3rem 20px;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 2rem;
      max-width: 1240px;
      margin: 0 auto 1.5rem;
    }

    .footer-brand { max-width: 380px; }

    .footer-brand h3 {
      color: #f8d261;
      margin-bottom: 1rem;
    }

    .footer-grid h3 {
      color: white;
      margin-bottom: 1rem;
      font-size: 1.05rem;
    }

    .footer-grid ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.85rem; }

    .footer-grid a,
    .footer-grid p { color: #cbd5ea; text-decoration: none; line-height: 1.8; }

    .footer-bottom {
      text-align: center;
      border-top: 1px solid rgba(255,255,255,0.08);
      padding-top: 1rem;
      color: rgba(255,255,255,0.65);
      font-size: 0.95rem;
    }

    .footer-highlight {
      color: #f8d261;
      font-weight: 700;
    }

    @media (max-width: 900px) {
      nav ul { gap: 1rem; }

      .nav-toggle { display: inline-flex; }

      .nav-links { display: none; }

      body.nav-open .nav-links {
        display: block;
        position: absolute;
        width: calc(100% - 40px);
        left: 20px;
        right: 20px;
        top: 76px;
        padding: 1.6rem;
        background: rgba(7, 32, 70, 0.97);
        border-radius: 18px;
        box-shadow: 0 24px 48px rgba(0, 0, 0, 0.22);
      }

      .nav-links ul { flex-direction: column; gap: 1rem; }

      .footer-grid { grid-template-columns: 1fr; }
    }
  </style>
  <head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | PREMIUM PROJECTS</title>
  
  <!-- THIS MUST BE HERE -->
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  
</head>
</head>
<body>

  <header>
    <nav>
      <a href="/" class="logo">
        <img src="/images/logo.png" alt="Premium Projects" class="brand-logo" />
        <span class="brand-name">PREMIUM PROJECTS</span>
      </a>

      <div class="nav-links">
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/topics">Topics</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/contact">Contact</a></li>

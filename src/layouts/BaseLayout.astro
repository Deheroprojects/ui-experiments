      </div>
      <div>
        <h3>Quick Links</h3>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/topics">Topics</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
      <div>
        <h3>Contact</h3>
        <p><strong>WhatsApp:</strong> <a href="https://wa.me/2347084857977?text=Hello%20Premium%20Projects%2C%20I%20need%20help%20with%20a%20research%20project.">+234 708 485 7977</a></p>
        <p><strong>Email:</strong> <a href="mailto:daitoroben@gmail.com">daitoroben@gmail.com</a></p>
        <p><strong>Phone:</strong> <a href="tel:+2348063406408">+234 8063406408</a></p>
      </div>
      <div>
        <h3>Why Choose Us</h3>
        <p>Expert academic support, tailored research, data analysis and reliable delivery. 100% confidentiality and student-first service.</p>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© 2024 PREMIUM PROJECTS. All rights reserved.</p>
      <p>Professional research project writing services for Nigerian students. Confidential, plagiarism-free and on-time delivery.</p>
    </div>
  </footer>

  <a href="https://wa.me/2347084857977?text=Hello%20Premium%20Projects%2C%20I%20need%20help%20with%20a%20research%20project." class="whatsapp-float">💬 WhatsApp</a>

  <script>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", user => {
        if (!user) {
          window.netlifyIdentity.on("login", () => {
            document.location.href = "/admin/";
          });
        }
      });
    }
  </script>
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <script>
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", user => {
      if (!user) {
        window.netlifyIdentity.on("login", () => {
          document.location.href = "/admin/";
